{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanxuanyu/meerkit/sdk/schema/module-descriptor.schema.json",
  "title": "Meerkit monitor module descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "name", "description", "config_schema", "parameters", "result_schema", "fields"],
  "properties": {
    "type": {
      "$ref": "#/$defs/identity"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "string",
      "minLength": 1
    },
    "result_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "list_summary": {
      "$ref": "#/$defs/listSummary"
    },
    "config_schema": {
      "type": "object"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "result_schema": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "result_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resultSet"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "listSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "separator": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "optionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options"],
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": ["string", "text", "list", "map", "boolean", "integer", "number", "url", "json", "duration"]
        },
        "order": {
          "type": "integer"
        },
        "full_width": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "default": true,
        "placeholder": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "options_when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/optionSet"
          }
        },
        "visible_when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "enabled_when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "type", "operators"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "operators": {
          "$ref": "#/$defs/operators"
        },
        "path": {
          "type": "boolean"
        }
      }
    },
    "resultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "type", "operators"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "operators": {
          "$ref": "#/$defs/operators"
        },
        "path": {
          "type": "boolean"
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "fields"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultField"
          }
        }
      }
    }
  }
}
