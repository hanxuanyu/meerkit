{
  "manifest_version": 3,
  "name": "Meerkit Browser Agent",
  "version": "0.3.0",
  "description": "Provides browser automation capabilities to a paired Meerkit instance.",
  "icons": {
    "16": "icons/meerkit.png",
    "32": "icons/meerkit.png",
    "48": "icons/meerkit.png",
    "128": "icons/meerkit.png"
  },
  "permissions": [
    "alarms",
    "cookies",
    "debugger",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Meerkit Browser Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/meerkit.png",
      "32": "icons/meerkit.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
