{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanxuanyu/meerkit/blob/main/plugins/manifest.schema.json",
  "title": "Meerkit plugin manifest",
  "description": "Schema for source and packaged meerkit-plugin.yaml manifests. Source manifests may use an empty artifacts array; the packager injects built artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "vendor",
    "desp",
    "url",
    "protocol",
    "modules",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Plugin manifest schema version."
    },
    "id": {
      "$ref": "#/$defs/identity",
      "description": "Stable plugin identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic plugin version."
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "desp": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable plugin description."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "protocol": {
      "$ref": "#/$defs/protocolRange"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Empty in source manifests and populated by the packaging tool.",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "version", "config_version", "result_schema_version"],
      "properties": {
        "type": {
          "$ref": "#/$defs/identity"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        },
        "result_schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "path", "size", "sha256"],
      "properties": {
        "goos": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "goarch": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "direct"
            },
            "command": {
              "const": ""
            },
            "args": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "not": {
                  "const": "{artifact}"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "command", "args"],
          "properties": {
            "mode": {
              "const": "interpreter"
            },
            "command": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "contains": {
                "const": "{artifact}"
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    }
  }
}
