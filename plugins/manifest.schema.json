{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "vendor", "desp", "url", "protocol", "modules", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "vendor": { "type": "string", "minLength": 1 },
    "desp": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "protocol": { "type": "object", "required": ["min", "max"] },
    "modules": { "type": "array", "minItems": 1 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
